{
  "name": "@gbesse/jev-mistral-reflex",
  "version": "0.1.2",
  "description": "Aiguille les décisions bornées vers Jev et confie les demandes ouvertes à un répondant compatible Mistral.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./jev": {
      "import": "./src/jev.mjs",
      "types": "./src/jev.d.mts"
    }
  },
  "bin": {
    "jev-mistral-reflex": "./bin/jev-mistral-reflex.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext docs/public-api-types.mts",
    "test": "node --test",
    "demo": "node examples/demo.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/jev-mistral-reflex.git"
  },
  "keywords": [
    "jev",
    "typesafe-ai",
    "france",
    "decision-automation"
  ],
  "files": [
    "src",
    "bin",
    "docs",
    "examples",
    "scripts"
  ]
}
